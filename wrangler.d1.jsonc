{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paychase-d1-candidate",
  "account_id": "0e3c5f2ac43af6e41deff7141d763bbd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "paychase-d1-candidate"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1_DB",
      "database_name": "paychase-neon-d1-live-20260906",
      "database_id": "5e84c410-f21f-4660-9d01-a1d8c35a2bb2",
      "migrations_dir": "d1/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "paychase-uploads"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://paychase.phu-mi.com",
    "CORE_API_URL": "https://core-api.phu-mi.com",
    "CORE_APP_ID": "paychase",
    "DATABASE_BACKEND": "d1"
  },
  "routes": [],
  "workers_dev": false,
  "preview_urls": false
}
