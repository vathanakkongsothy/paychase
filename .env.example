# PayChase local development — Neon Postgres (Saas project, database "paychase")
# Copy the connection string from the Neon console (Settings → Connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/paychase?sslmode=require"

OPENAI_API_KEY=""
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Phumi Core (server-only identity/tenancy sync)
CORE_API_URL="https://core-api.phu-mi.com"
CORE_APP_ID="paychase"
CORE_REQUEST_SECRET="replace-with-your-paychase-core-request-secret"

# Demo account after `pnpm db:seed`: demo@paychase.app / paychase
