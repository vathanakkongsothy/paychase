{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paychase",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "paychase"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paychase",
      "database_id": "d48f6b9a-0d1c-4609-a99a-d069e519c49b",
      "migrations_dir": "migrations/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "paychase-uploads"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "workers_dev": true,
  "preview_urls": true
}
